pipeline {

    agent { label 'backend' }   // pins the pipeline to the Jenkins worker node labeled "backend"

    environment {
        AWS_REGION       = 'eu-north-1'                      // must match your EKS cluster and ECR region
        AWS_ACCOUNT_ID   = credentials('aws-account-id')     // Jenkins "Secret text" credential

        ECR_REPOSITORY   = 'arms-backend'
        EKS_CLUSTER      = 'arms-eks'
        NAMESPACE        = 'arms'

        ECR_REGISTRY     = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        ECR_IMAGE        = "${ECR_REGISTRY}/${ECR_REPOSITORY}"

        SONARQUBE_SERVER = 'SonarQube'
    }

    stages {

        // 1. Get application code from private GitHub repository
        stage('Checkout') {
            steps {
                git(
                    branch: 'main',
                    credentialsId: 'github-backend',
                    url: 'git@github.com:YOUR_ORG/ARMS-Backend.git'
                )
            }
        }


        // 2. Get Git commit ID and use it as image tag
        stage('Get Git Commit ID') {
            steps {
                script {
                    env.IMAGE_TAG = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()

                    echo "Image Tag: ${env.IMAGE_TAG}"
                }
            }
        }



        // 3. Analyze source code
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv("${SONARQUBE_SERVER}") {
                    sh '''
                        sonar-scanner \
                        -Dsonar.projectKey=arms-backend \
                        -Dsonar.projectName=ARMS-Backend \
                        -Dsonar.sources=.
                    '''
                }
            }
        }





        // 4. Check SonarQube quality gate

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // 5. Build Docker image
        stage('Docker Build') {
            steps {
                sh """
                    docker build \
                    -t ${ECR_IMAGE}:${env.IMAGE_TAG} .
                """
            }
        }

        // 6. Scan Docker image
        stage('Trivy Image Scan') {
            steps {
                sh """
                    trivy image \
                    --severity HIGH,CRITICAL \
                    --exit-code 1 \
                    ${ECR_IMAGE}:${env.IMAGE_TAG}
                """
            }
        }

        // 7. Login to ECR - the Jenkins EC2 instance's IAM Role supplies the AWS credentials
        stage('Login to ECR') {
            steps {
                sh """
                    aws ecr get-login-password \
                    --region ${AWS_REGION} | \
                    docker login \
                    --username AWS \
                    --password-stdin ${ECR_REGISTRY}
                """
            }
        }




        // 8. Push image to existing ECR repository


        stage('Push Image to ECR') {
            steps {
                sh """
                    docker push ${ECR_IMAGE}:${env.IMAGE_TAG}
                """
            }
        }


        // 9. Human approval before production deployment


        stage('Production Approval') {
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input(
                        message: "Deploy ${ECR_IMAGE}:${env.IMAGE_TAG} to production?",
                        ok: "Approve Deployment"
                    )
                }
            }
        }

        // 10. Configure kubectl access to EKS


        stage('Configure EKS Access') {
            steps {
                sh """
                    aws eks update-kubeconfig \
                    --region ${AWS_REGION} \
                    --name ${EKS_CLUSTER}
                """
            }
        }

      


  // 11. Apply Kubernetes configuration in the numbered order.
        //     05-deployment.yaml is templated with envsubst so the image is injected
        //     in a single apply. It must reference the image as:
        //         image: ${ECR_IMAGE}:${IMAGE_TAG}
        //     Single-quoted block: the shell, not Groovy, expands the variables.










        stage('Apply Kubernetes Configuration') {
            steps {
                sh '''
                    kubectl apply -f k8s/01-namespace.yaml

                    kubectl apply -f k8s/02-serviceaccount.yaml -n ${NAMESPACE}
                    kubectl apply -f k8s/03-configmap.yaml -n ${NAMESPACE}
                    kubectl apply -f k8s/04-secret-provider-class.yaml -n ${NAMESPACE}

                    envsubst '${ECR_IMAGE} ${IMAGE_TAG}' < k8s/05-deployment.yaml | kubectl apply -n ${NAMESPACE} -f -

                    kubectl apply -f k8s/06-service.yaml -n ${NAMESPACE}
                    kubectl apply -f k8s/07-hpa.yaml -n ${NAMESPACE}
                    kubectl apply -f k8s/08-pdb.yaml -n ${NAMESPACE}
                    kubectl apply -f k8s/09-network-policy.yaml -n ${NAMESPACE}
                    kubectl apply -f k8s/10-ingress.yaml -n ${NAMESPACE}
                '''
            }
        }

        // 12. Wait for rolling update to complete; roll back automatically on failure

        stage('Deployment Verification') {
            steps {
                script {
                    try {
                        sh """
                            kubectl -n ${NAMESPACE} \
                            rollout status deployment/arms-backend \
                            --timeout=5m
                        """
                    } catch (err) {
                        echo "Rollout failed - rolling back to previous revision."
                        sh """
                            kubectl -n ${NAMESPACE} \
                            rollout undo deployment/arms-backend
                        """
                        error("Deployment failed and was rolled back: ${err}")
                    }
                }
            }
        }


        // 13. Verify Kubernetes resources

        stage('Verify Deployment') {
            steps {
                sh """
                    kubectl -n ${NAMESPACE} get pods
                    kubectl -n ${NAMESPACE} get svc
                    kubectl -n ${NAMESPACE} get ingress
                    kubectl -n ${NAMESPACE} get hpa
                """
            }
        }
    }

    post {

        success {
            echo "ARMS Backend ${env.IMAGE_TAG} deployed successfully."
        }

        failure {
            echo "ARMS Backend deployment failed."
        }

        always {
            echo "Jenkins pipeline completed."
        }
    }
}
